/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/version.json
  Cache-Control: no-store
/audio/music-manifest.json
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/audio/licensed-*
  Cache-Control: public, max-age=31536000, immutable
/audio/voice-*
  Cache-Control: public, max-age=31536000, immutable
